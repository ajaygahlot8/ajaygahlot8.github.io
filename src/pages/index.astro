---
import Base from '../layouts/Base.astro';
import AgentCallReplay from '../components/AgentCallReplay.astro';
import { me, getPosts, readingTime, fmtDate } from '../lib/site';

const posts = await getPosts();
const latest = posts.slice(0, 3);
const has = (slug: string) => posts.some((p) => p.id === slug);
const lab = [
  { t: 'Claude as the agent’s brain', d: 'Hermes runs on Claude Opus; subagents fan out work in parallel on Sonnet, GLM or Grok.', tags: 'claude · subagents', slug: 'claude-as-the-brain-of-my-ai-agent' },
  { t: 'Long-term memory (Mnemosyne)', d: 'Local hybrid memory in SQLite: vector similarity, FTS5 rank and an importance score, with temporal decay.', tags: 'sqlite · sqlite-vec · fts5' },
  { t: 'Ops through the agent', d: 'Watches a Raspberry Pi homelab and routes messages to WhatsApp groups by urgency.', tags: 'homelab · monitoring' },
  { t: 'Skills as procedural memory', d: 'The agent writes and maintains its own runbooks: 250+ SKILL.md files, loaded only when relevant.', tags: 'skills · runbooks' },
  { t: 'Scheduled agent jobs', d: 'About 30 crons: daily digests, monitors, reminders.', tags: 'cron · digests' },
];
const person = {
  '@context': 'https://schema.org', '@type': 'Person', name: me.name, jobTitle: 'Engineering Manager',
  worksFor: { '@type': 'Organization', name: 'Gojek' }, url: Astro.site, email: `mailto:${me.email}`,
  address: { '@type': 'PostalAddress', addressLocality: 'Bengaluru', addressCountry: 'IN' },
  sameAs: [me.linkedin, me.github],
};
---
<Base description="Engineering Manager at Gojek (GoTo Group) in Bengaluru. I lead teams on an insurance platform handling 40M transactions a month, and build personal AI agents on the side." jsonLd={person}>
  <div class="wrap">
    <section class="hero" aria-labelledby="h1">
      <div>
        <p class="eyebrow">Engineering Manager · Gojek (GoTo Group) · Bengaluru</p>
        <h1 class="display" id="h1">I lead engineers.<br /> I still build.</h1>
        <p class="sub">I lead <strong>12 engineers</strong> across India and Indonesia, and helped build Gojek’s embedded insurance platform from zero to <strong>40M insured transactions a month</strong>. Off the clock I build AI agents, including one you can phone on WhatsApp.</p>
        <div class="cta">
          <a class="btn primary" href="/writing/">Read the writing</a>
          <a class="btn" href={`mailto:${me.email}`}>Get in touch</a>
        </div>
      </div>
      <AgentCallReplay />
    </section>

    <section class="sec" aria-labelledby="outcomes">
      <h2 class="label" id="outcomes">Selected outcomes</h2>
      <ul class="outcomes">
        <li><span class="num">0 → 40M</span><span>insured transactions a month on Gojek’s embedded insurance platform, which I helped build from zero.</span></li>
        <li><span class="num">2 weeks → 4 days</span><span>to launch a new insurance product, after a re-architecture to modular product templates that I made the case for and sequenced.</span></li>
        <li><span class="num">45 → 10 min</span><span>incident triage, with an AI engineering assistant now used by four teams.</span></li>
        <li><span class="num">5 promoted</span><span>direct reports in two years, two of them into lead roles.</span></li>
        <li><span class="num">0 downtime</span><span>moving ~12 microservices and 5 databases from Google Cloud to Alibaba Cloud.</span></li>
      </ul>
    </section>

    <section class="sec" aria-labelledby="now">
      <h2 class="label" id="now">Now</h2>
      <div>
        <p class="prose-lg">Engineering Manager at Gojek since December 2023, running the Insurance Platform and Financial Management streams: backend, mobile and SDET engineers in two countries, plus the AI-first practice that sits across them.</p>
        <a class="more-link" href="/about/">More about my work and background →</a>
      </div>
    </section>

    <section class="sec" aria-labelledby="lab">
      <h2 class="label" id="lab">The lab</h2>
      <ul class="lab">
        <li class="feat">
          <h3><a href="/writing/calling-my-ai-agent-on-whatsapp/">Hermes on a WhatsApp call</a></h3>
          <p>Phone the agent’s number and a full-duplex GPT-Live-1 voice picks up. Anything that needs real work goes to a fresh Hermes chat on Claude Opus, and the answer is spoken back or texted after hang-up. The owner gets the full agent, known family get tasks, strangers get conversation only.</p>
          <p class="tags">baileys · whatsapp voip · webassembly · tiered trust</p>
          <a class="more" href="/writing/calling-my-ai-agent-on-whatsapp/">Read how it works →</a>
        </li>
        {lab.map((l) => (
          <li>
            <h3>{l.slug && has(l.slug) ? <a href={`/writing/${l.slug}/`}>{l.t}</a> : l.t}</h3>
            <p>{l.d}</p>
            <span class="tags">{l.tags}</span>
          </li>
        ))}
      </ul>
    </section>

    <section class="sec" aria-labelledby="writing">
      <h2 class="label" id="writing">Writing</h2>
      <div>
        {latest.length ? (
          <ul class="plist">
            {latest.map((p) => (
              <li><a href={`/writing/${p.id}/`}>
                <time datetime={p.data.pubDate.toISOString()}>{fmtDate(p.data.pubDate)}</time>
                <span class="t">{p.data.title}</span>
                <span class="rt">{readingTime(p.body)}</span>
              </a></li>
            ))}
          </ul>
        ) : <p class="empty-note">First posts are on the way.</p>}
        <a class="more-link" href="/writing/">All writing →</a>
      </div>
    </section>

    <section class="sec" aria-labelledby="contact">
      <h2 class="label" id="contact">Contact</h2>
      <div class="contact">
        <span class="copy-row"><a href={`mailto:${me.email}`}>{me.email}</a><button type="button" data-copy={me.email} aria-label="Copy email address">Copy</button></span>
        <a class="btn" href={me.linkedin} rel="me noopener">LinkedIn</a>
        <a class="btn" href={me.github} rel="me noopener">GitHub</a>
      </div>
    </section>
  </div>
</Base>
